# Copy this file to secrets.yaml and fill it in. secrets.yaml is git-ignored.

# WiFi the device joins
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# ESPHome native API noise key (32 random bytes, base64).
# Generate one:  openssl rand -base64 32
# The SAME key must be entered when adding the device in Home Assistant.
api_key: "replace-with-openssl-rand-base64-32-output="

# Password for the device's fallback WiFi AP ("Polytron Wash Setup")
ap_password: "change-me"
# Web UI + OTA digest auth (served on port 80)
web_username: "admin"
web_password: "choose-a-password"
